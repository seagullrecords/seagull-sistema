# Variables de entorno para SEAGULL RECORDS
# Copia este archivo a .env y completa los valores

# Base de datos PostgreSQL (Neon - https://neon.tech)
# Crea una cuenta gratis y copia la connection string aquí
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Secreto para autenticación (genera uno en https://generate-secret.vercel.app/)
NEXTAUTH_SECRET="genera-una-cadena-aleatoria-aqui"

# URL de tu aplicación (cambia por tu dominio real en Vercel)
NEXT_PUBLIC_APP_URL="https://tu-app.vercel.app"
